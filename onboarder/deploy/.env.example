# =============================================================================
# The devnet's Onboarder — copy to .env and fill in. .env is gitignored.
# =============================================================================

# A Base Sepolia JSON-RPC endpoint. The public one works; a hosted one (with
# its API key in the URL) is less rate-limited. Only its host is ever logged.
EVM_RPC_URL=https://sepolia.base.org

# The gas payer's key is NOT set here: it is ./onboarder.key, mounted as a
# file (README.md § "The key").

# ── Optional ─────────────────────────────────────────────────────────────────

# The branch of toon-protocol/infra this host follows. auto-apply.sh
# fast-forwards it every five minutes and applies onboarder/deploy.
# TRACK_BRANCH=main
