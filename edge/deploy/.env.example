# =============================================================================
# The devnet edge — copy to .env and fill in. .env is gitignored.
# =============================================================================

# Where Let's Encrypt sends expiry notices.
ACME_EMAIL=you@example.com

# ── DNS-01 through Porkbun ───────────────────────────────────────────────────
# Every certificate on this host, the wildcard *.gw.devnet included, is issued
# by writing a `_acme-challenge` TXT record in toonprotocol.dev. The same pair
# the workload gateway node's certbot used (gateway/deploy/.env): copy them over
# rather than minting new ones. API access must be enabled for the domain on
# Porkbun. Neither is ever printed.
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────

# The branch of toon-protocol/infra this host follows. auto-apply.sh
# fast-forwards it every five minutes and applies edge/deploy.
# TRACK_BRANCH=main
